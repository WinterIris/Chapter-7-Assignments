void displayAll(const vector<string>& studentNames, const vector<vector<int>>& studentGrades) {
    if (studentNames.empty()) {
        cout << "No students to display.\n";
        return;
    }

    for (size_t i = 0; i < studentNames.size(); ++i) {
        cout << "\nStudent: " << studentNames[i] << "\nGrades: ";
        for (int grade : studentGrades[i]) {
            cout << grade << " ";
        }

        double avg = computeAverageWithDrop(studentGrades[i]);
        cout << "\nAverage (lowest dropped): " << avg;
        cout << "\nLetter Grade: " << getLetterGrade(avg) << "\n";
    }
}

int getValidatedGrade() {
    int grade;
    while (true) {
        cout << "Enter grade (0–100, or -1 to stop): ";
        cin >> grade;

        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input.\n";
        } else if ((grade >= 0 && grade <= 100) || grade == -1) {
            return grade;
        } else {
            cout << "Grade must be between 0 and 100.\n";
        }
    }
}

double computeAverageWithDrop(const vector<int>& grades) {
    if (grades.empty()) return 0.0;
    if (grades.size() == 1) return grades[0];

    int sum = 0, minGrade = grades[0];
    for (int g : grades) {
        sum += g;
        if (g < minGrade) minGrade = g;
    }
    return static_cast<double>(sum - minGrade) / (grades.size() - 1);
}

char getLetterGrade(double average) {
    if (average >= 90) return 'A';
    if (average >= 80) return 'B';
    if (average >= 70) return 'C';
    if (average >= 60) return 'D';
    return 'F';
}

void searchStudent(const vector<string>& studentNames, vector<vector<int>>& studentGrades) {
    string name;
    cout << "Enter student name to search: ";
    cin >> ws;
    getline(cin, name);

    auto it = find(studentNames.begin(), studentNames.end(), name);
    if (it == studentNames.end()) {
        cout << "Student not found.\n";
        return;
    }

    size_t index = distance(studentNames.begin(), it);
    cout << "Grades for " << name << ": ";
    for (int g : studentGrades[index]) cout << g << " ";
    cout << "\nAverage: " << computeAverageWithDrop(studentGrades[index]) 
         << " (" << getLetterGrade(computeAverageWithDrop(studentGrades[index])) << ")\n";

    cout << "\nEdit Menu:\n1. Add Score\n2. Change Score\n3. Delete Score\n4. Back\nChoose: ";
    int choice;
    cin >> choice;

    switch (choice) {
        case 1: {
            int newGrade = getValidatedGrade();
            if (newGrade != -1) studentGrades[index].push_back(newGrade);
            break;
        }
        case 2: {
            int pos;
            cout << "Enter position of score to change (1-based index): ";
            cin >> pos;
            if (pos < 1 || pos > studentGrades[index].size()) {
                cout << "Invalid position.\n";
            } else {
                int newGrade = getValidatedGrade();
                if (newGrade != -1) studentGrades[index][pos - 1] = newGrade;
            }
            break;
        }
        case 3: {
            int pos;
            cout << "Enter position of score to delete (1-based index): ";
            cin >> pos;
            if (pos < 1 || pos > studentGrades[index].size()) {
                cout << "Invalid position.\n";
            } else {
                studentGrades[index].erase(studentGrades[index].begin() + pos - 1);
                cout << "Score deleted.\n";
            }
            break;
        }
        default:
            break;
    }
}

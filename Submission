#include <iostream>
#include <vector>
#include <string>
#include <fstream>
#include <limits>
#include <algorithm>
#include <sstream>

using namespace std;

const string FILE_NAME = "gradebook.txt";

// Function prototypes
void displayMenu();
void loadFromFile(vector<string>& studentNames, vector<vector<int>>& studentGrades);
void saveToFile(const vector<string>& studentNames, const vector<vector<int>>& studentGrades);
void addStudents(vector<string>& studentNames, vector<vector<int>>& studentGrades);
void addGrades(const vector<string>& studentNames, vector<vector<int>>& studentGrades);
void displayAll(const vector<string>& studentNames, const vector<vector<int>>& studentGrades);
void searchStudent(const vector<string>& studentNames, vector<vector<int>>& studentGrades);
double computeAverageWithDrop(const vector<int>& grades);
char getLetterGrade(double average);
int getValidatedGrade();

int main() {
    vector<string> studentNames;
    vector<vector<int>> studentGrades;

    loadFromFile(studentNames, studentGrades);

    int choice;

    do {
        displayMenu();
        cout << "Enter your choice: ";
        cin >> choice;

        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "Invalid input. Please enter a number.\n";
            continue;
        }

        switch (choice) {
            case 1:
                addStudents(studentNames, studentGrades);
                break;
            case 2:
                addGrades(studentNames, studentGrades);
                break;
            case 3:
                displayAll(studentNames, studentGrades);
                break;
            case 4:
                searchStudent(studentNames, studentGrades);
                break;
            case 5:
                saveToFile(studentNames, studentGrades);
                cout << "Data saved. Exiting.\n";
                break;
            default:
                cout << "Invalid choice. Try again.\n";
        }
    } while (choice != 5);

    return 0;
}

void displayMenu() {
    cout << "\n--- Grade Book Menu ---\n";
    cout << "1. Add Students\n";
    cout << "2. Add Grades\n";
    cout << "3. Display All Students and Grades\n";
    cout << "4. Search and Edit Student\n";
    cout << "5. Save and Exit\n";
}

void loadFromFile(vector<string>& studentNames, vector<vector<int>>& studentGrades) {
    ifstream inFile(FILE_NAME);
    if (!inFile) return;

    string line;
    while (getline(inFile, line)) {
        istringstream iss(line);
        string name;
        getline(iss, name, ':');

        studentNames.push_back(name);
        vector<int> grades;
        string gradeStr;
        while (getline(iss, gradeStr, ',')) {
            grades.push_back(stoi(gradeStr));
        }
        studentGrades.push_back(grades);
    }
    inFile.close();
}

void saveToFile(const vector<string>& studentNames, const vector<vector<int>>& studentGrades) {
    ofstream outFile(FILE_NAME);
    for (size_t i = 0; i < studentNames.size(); ++i) {
        outFile << studentNames[i] << ":";
        for (size_t j = 0; j < studentGrades[i].size(); ++j) {
            outFile << studentGrades[i][j];
            if (j != studentGrades[i].size() - 1) outFile << ",";
        }
        outFile << "\n";
    }
    outFile.close();
}


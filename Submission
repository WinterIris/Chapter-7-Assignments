void addGrades(const vector<string>& studentNames, vector<vector<int>>& studentGrades) {
    if (studentNames.empty()) {
        cout << "No students available. Please add students first.\n";
        return;
    }

    for (size_t i = 0; i < studentNames.size(); ++i) {
